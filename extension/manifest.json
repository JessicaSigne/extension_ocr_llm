

{
  "manifest_version": 3,
  "name": "SnapLearn Assistant",
  "version": "1.0.0",
  "description": "Capture une zone d'écran et utilise l'OCR et un LLM.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}